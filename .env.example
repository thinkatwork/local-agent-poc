# Copy this file to .env (cp .env.example .env) and fill in your own values.
# .env is excluded from Git. Never commit it or paste keys into a chat.

# Model provider: "ollama" (local, default) or "gemini" (Google cloud).
MODEL_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b

# Google Gemini (only used when MODEL_PROVIDER=gemini or selected in the UI).
GEMINI_API_KEY=
# Model ID checked against Google's docs on 2026-11-13. Re-check before use.
GEMINI_MODEL=gemini-3.1-flash-lite
# "free": stop at the first quota error, never continue on paid usage.
# "paid": requires the two prices and MAX_ESTIMATED_SPEND_PER_QUESTION below.
GEMINI_TIER=free
# Standard paid-tier USD per 1M tokens for GEMINI_MODEL, from
# https://ai.google.dev/gemini-api/docs/pricing (checked 2026-11-13). Update when prices change.
GEMINI_INPUT_PRICE_PER_M=0.25
GEMINI_OUTPUT_PRICE_PER_M=1.50
# Optional estimated USD cap per question (required when GEMINI_TIER=paid).
MAX_ESTIMATED_SPEND_PER_QUESTION=

# Tavily web search (https://app.tavily.com/home).
TAVILY_API_KEY=

# Per-question limits, enforced in Python.
MAX_MODEL_CALLS_PER_QUESTION=3
MAX_SEARCHES_PER_QUESTION=3
MAX_FETCHES_PER_QUESTION=4
MAX_OUTPUT_TOKENS_PER_CALL=1024
MAX_INPUT_CHARS_PER_CALL=40000
MODEL_REQUEST_TIMEOUT_SECONDS=60
